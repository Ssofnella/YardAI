# Yardline environment.
# Copy to .env.local for local overrides. Leave DATABASE_URL empty to use the
# embedded Postgres (PGlite) stored in .data/pglite. No account required.

# Postgres connection string. Set this on Vercel to the Supabase pooler URI
# (session mode). When empty, the app uses embedded Postgres on disk.
DATABASE_URL=

# Optional directory for the embedded database. Defaults to .data/pglite.
YARD_DATA_DIR=

# Supabase client keys. Not required for the local demo. The Next.js server
# talks to Postgres directly. These are for a later Auth and Realtime wiring,
# and for running the SQL policies in supabase/migrations against a project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Imagery. Default is self-hosted public-domain USDA NAIP (Texas 2022) under
# public/imagery. plain draws on an empty canvas. licensed_basemap is display
# only, and only when both of the next two are set. Never send those tiles to a model.
YARD_IMAGERY_PROVIDER=naip
YARD_LICENSED_IMAGERY=
YARD_LICENSED_TILE_URL=
YARD_LICENSED_CAPTURE_YEAR=

# Geocoder. Default is a pin or device GPS. mapbox_permanent also needs the
# server-only token below. Do not put that token in NEXT_PUBLIC_.
YARD_GEOCODER=manual_pin
YARD_MAPBOX_TOKEN=

# AI. Default is deterministic rules. model also needs an API key. The gate
# recommendation does not call the model. Ask and email parsing may.
YARD_AI_PROVIDER=rules
YARD_AI_API_KEY=
YARD_AI_BASE_URL=https://api.openai.com/v1
YARD_AI_MODEL=gpt-4o-mini

# Inbound appointment mail. The address is fictional until you point a mailbox here.
YARD_EMAIL_DOMAIN=in.yardline.example

# OpenStreetMap building hints. Off by default. A hint is not copied into the yard.
YARD_OSM_HINTS=
