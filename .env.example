# Yardline environment.
# Copy to .env.local for local overrides. Leave DATABASE_URL empty to use the
# embedded Postgres (PGlite) stored in .data/pglite. No account required.

# Postgres connection string. Set this on Vercel to the Supabase pooler URI
# (session mode). When empty, the app uses embedded Postgres on disk.
DATABASE_URL=

# Optional directory for the embedded database. Defaults to .data/pglite.
YARD_DATA_DIR=

# Supabase client keys. Not required for the local demo. The Next.js server
# talks to Postgres directly. These are for a later Auth and Realtime wiring,
# and for running the SQL policies in supabase/migrations against a project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
